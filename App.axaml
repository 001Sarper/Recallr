<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Recallr"
             xmlns:vm="clr-namespace:Recallr.Views"
             x:Class="Recallr.App"
             RequestedThemeVariant="Default">
             <!-- "Default" folgt dem System-Theme. Für immer Dark/Light: "Dark" bzw. "Light" -->

             <Application.DataTemplates>
                 <local:ViewLocator/>
                 <DataTemplate DataType="{x:Type vm:CourseView}">
                     <vm:CourseView />
                 </DataTemplate>
                 <DataTemplate DataType="{x:Type vm:LearningsheetView}">
                     <vm:LearningsheetView />
                 </DataTemplate>
                 <DataTemplate DataType="{x:Type vm:SettingsView}">
                     <vm:SettingsView />
                 </DataTemplate>
             </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaProgressRing/Styles/ProgressRing.xaml"/>
        <StyleInclude Source="/Ressources/ButtonStyles.axaml"/>
        <StyleInclude Source="/Ressources/ChatStyles.axaml"/>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Ressources/ButtonBrushes.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Dark">
                    <!-- Grundflächen -->
                    <SolidColorBrush x:Key="BackgroundColor">#0D1117</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceColor">#161B22</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderColor">#30363D</SolidColorBrush>

                    <!-- Text -->
                    <SolidColorBrush x:Key="TextPrimaryColor">#E6EDF3</SolidColorBrush>
                    <SolidColorBrush x:Key="TextSecondaryColor">#8B949E</SolidColorBrush>

                    <!-- Akzent (Buttons, aktive Nav-Elemente, Links) -->
                    <SolidColorBrush x:Key="AccentColor">#2F81F7</SolidColorBrush>

                    <!-- Wissensstand / Lernfortschritt -->
                    <!-- 1. Fortschritt (Line Chart) -->
                    <SolidColorBrush x:Key="CardProgressBackground" Color="#F8F9FA"/>
                    <!-- 2. Activity (Heatmap) -->
                    <SolidColorBrush x:Key="CardActivityBackground" Color="#FFFFFF"/>
                    <!-- 3. Topics (Bar Chart) -->
                    <SolidColorBrush x:Key="CardTopicsBackground" Color="#F8F9FA"/>
                    <!-- 4. Status (Donut Chart) -->
                    <SolidColorBrush x:Key="CardStatusBackground" Color="#FFFFFF"/>
                    
                    <SolidColorBrush x:Key="NavBackgroundColor">#161B22</SolidColorBrush>      <!-- = SurfaceColor, Container-Hintergrund -->
                    <SolidColorBrush x:Key="NavBorderColor">#30363D</SolidColorBrush>          <!-- = BorderColor, Trennlinie zum Content -->
                    
                    <SolidColorBrush x:Key="ChatAiBackground" Color="#1F242E"/>      <!-- Leicht heller als Nav BG für Kontrast -->
                    <SolidColorBrush x:Key="ChatAiBorder" Color="#30363D"/>          <!-- Passt zu NavBorderColor -->

                    <!-- User Bubble -->
                    <SolidColorBrush x:Key="ChatUserBackground" Color="#238636"/>    <!-- Grün-Akzent (GitHub-Style) -->
                    <SolidColorBrush x:Key="ChatUserBorder" Color="#3FB950"/> 

                    <SolidColorBrush x:Key="NavItemColor">#8B949E</SolidColorBrush>            <!-- inaktiver Tab-Text/Icon -->
                    <SolidColorBrush x:Key="NavItemHoverColor">#E6EDF3</SolidColorBrush>       <!-- Text beim Hover -->
                    <SolidColorBrush x:Key="NavItemHoverBackgroundColor">#21262D</SolidColorBrush> <!-- leichtes Hover-Highlight -->

                    <SolidColorBrush x:Key="NavItemActiveColor">#E6EDF3</SolidColorBrush>      <!-- aktiver Tab-Text -->
                    <SolidColorBrush x:Key="NavItemActiveBackgroundColor">#1F2937</SolidColorBrush> <!-- Hintergrund des aktiven Tabs -->
                    <SolidColorBrush x:Key="NavIndicatorColor">#2F81F7</SolidColorBrush>       <!-- = AccentColor, Unterstrich/Marker -->
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <!-- Grundflächen -->
                    <SolidColorBrush x:Key="BackgroundColor">#e8f1fb</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceColor">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderColor">#D0D7DE</SolidColorBrush>

                    <!-- Text -->
                    <SolidColorBrush x:Key="TextPrimaryColor">#0D1117</SolidColorBrush>
                    <SolidColorBrush x:Key="TextSecondaryColor">#57606A</SolidColorBrush>

                    <!-- Akzent (Buttons, aktive Nav-Elemente, Links) -->
                    <SolidColorBrush x:Key="AccentColor">#0969DA</SolidColorBrush>

                    <!-- Wissensstand / Lernfortschritt -->
                    <!-- 1. Fortschritt (Line Chart) -->
                    <SolidColorBrush x:Key="CardProgressBackground" Color="#F8F9FA"/>
                    <!-- 2. Activity (Heatmap) -->
                    <SolidColorBrush x:Key="CardActivityBackground" Color="#FFFFFF"/>
                    <!-- 3. Topics (Bar Chart) -->
                    <SolidColorBrush x:Key="CardTopicsBackground" Color="#F8F9FA"/>
                    <!-- 4. Status (Donut Chart) -->
                    <SolidColorBrush x:Key="CardStatusBackground" Color="#FFFFFF"/>
                    
                    <SolidColorBrush x:Key="NavBackgroundColor">#FFFFFF</SolidColorBrush>      <!-- = SurfaceColor -->
                    <SolidColorBrush x:Key="NavBorderColor">#D0D7DE</SolidColorBrush>          <!-- = BorderColor -->
                    
                    <SolidColorBrush x:Key="ChatAiBackground" Color="#F6F8FA"/>     <!-- Helles Grau (ähnlich GitHub Light) -->
                    <SolidColorBrush x:Key="ChatAiBorder" Color="#D0D7DE"/>          <!-- Subtile Border -->

                    <!-- User Bubble -->
                    <SolidColorBrush x:Key="ChatUserBackground" Color="#238636"/>    <!-- Grün-Akzent (GitHub-Style) -->
                    <SolidColorBrush x:Key="ChatUserBorder" Color="#3FB950"/> 

                    <SolidColorBrush x:Key="NavItemColor">#57606A</SolidColorBrush>            <!-- inaktiver Tab-Text/Icon -->
                    <SolidColorBrush x:Key="NavItemHoverColor">#0D1117</SolidColorBrush>
                    <SolidColorBrush x:Key="NavItemHoverBackgroundColor">#F0F3F6</SolidColorBrush>

                    <SolidColorBrush x:Key="NavItemActiveColor">#0D1117</SolidColorBrush>
                    <SolidColorBrush x:Key="NavItemActiveBackgroundColor">#E1EBFA</SolidColorBrush>
                    <SolidColorBrush x:Key="NavIndicatorColor">#0969DA</SolidColorBrush>       <!-- = AccentColor -->
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
