<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Recallr.ViewModels"
             xmlns:m="clr-namespace:Recallr.Models.Configuration"
             xmlns:models="clr-namespace:Recallr.Models.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Recallr.Views.LearningsheetView"
             x:DataType="vm:LearningsheetViewModel">
    <Grid RowDefinitions="45,Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBox CornerRadius="12" Grid.Column="0" Height="36" Margin="10,5,5,0" HorizontalAlignment="Stretch"
                     VerticalAlignment="Center" PlaceholderText="{models:Tr learn_sheet_search_bar}" Text="{Binding SearchText}"/>
            <Button Margin="0,5,10,0" Height="35" Classes="primary" Grid.Row="0" Grid.Column="1"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding CreateLearnsheetCommand}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Path Data="M8,2 L8,14 M2,8 L14,8"
                          Stroke="{DynamicResource ButtonPrimaryForeground}"
                          StrokeThickness="2"
                          StrokeLineCap="Round"
                          Width="16" Height="16"
                          Stretch="None"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                    <TextBlock Text="{models:Tr learn_sheet_add_btn}" FontSize="13" VerticalAlignment="Center"
                               Foreground="{DynamicResource ButtonPrimaryForeground}"/>
                </StackPanel>
            </Button>
        </Grid>
        <Separator Margin="0,10,0,10" Grid.Row="1" />

        <!-- Learnsheet list with checkboxes -->
        <ScrollViewer Margin="10,10,10,0" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid>
                <!-- Empty state -->
                <StackPanel IsVisible="{Binding !SelectableLearnsheets.Count}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="0,60,0,0">
                    <TextBlock Text="📝" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Create your first learn sheet!"
                               FontSize="15"
                               Foreground="{DynamicResource TextSecondaryColor}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding SelectableLearnsheets}" IsVisible="{Binding SelectableLearnsheets.Count}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LearningsheetSelectionItem}">
                        <Border CornerRadius="12"
                                Padding="16,10"
                                Background="{DynamicResource SurfaceColor}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <!-- Checkbox for multi-select -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelected}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0" />

                                <!-- Sheet info -->
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="0,0,50,0">
                                    <TextBlock Grid.Row="0" FontSize="16"
                                               Text="{Binding Learnsheet.Name}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryColor}" />
                                    <TextBlock Grid.Row="1" FontSize="12"
                                               Text="{Binding Learnsheet.TestDate}"
                                               Foreground="{DynamicResource TextSecondaryColor}"
                                               Margin="0,2,0,0" />
                                    <TextBlock Grid.Row="2" FontSize="14"
                                               Text="{Binding Learnsheet.Description}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Justify" />
                                </Grid>

                                <!-- Action buttons -->
                                <Grid Grid.Column="2" RowDefinitions="*,*">
                                    <Button Grid.Row="0" Classes="edit" Content="{models:Tr learn_sheet_view_btn}"
                                            Margin="0,0,0,5" Width="100"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding $parent[ItemsControl].((vm:LearningsheetViewModel)DataContext).OpenLernzettelCommand}"
                                            CommandParameter="{Binding Learnsheet}" />
                                    <Button Grid.Row="1" Classes="delete" Content="{models:Tr learn_sheet_del_btn}"
                                            Margin="0,5,0,0" Width="100"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding $parent[ItemsControl].((vm:LearningsheetViewModel)DataContext).DeleteLernzettelCommand}"
                                            CommandParameter="{Binding Learnsheet}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- Floating action bar — visible when ≥1 sheet is selected -->
        <Border Grid.Row="3"
                IsVisible="{Binding IsActionBarVisible}"
                Margin="10,8,10,10"
                Padding="16,10"
                CornerRadius="12"
                Background="{DynamicResource SurfaceColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <!-- Selection count label -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="📋" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedCountLabel}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryColor}"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Clear selection button -->
                <Button Grid.Column="1"
                        Classes="secondary"
                        Margin="0,0,8,0"
                        Command="{Binding ClearSelectionCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Path Data="M3,3 L13,13 M13,3 L3,13"
                              Stroke="{DynamicResource TextPrimaryColor}"
                              StrokeThickness="1.5"
                              StrokeLineCap="Round"
                              Width="12" Height="12"
                              Stretch="None"
                              VerticalAlignment="Center" />
                        <TextBlock Text="{models:Tr clear_selection}" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                </Button>

                <!-- Generate Exam button -->
                <Button Grid.Column="2"
                        Classes="primary"
                        Command="{Binding GenerateExamCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="📝" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{models:Tr generate_exam}" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource ButtonPrimaryForeground}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>