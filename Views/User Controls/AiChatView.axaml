<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Recallr.ViewModels"
             xmlns:models="clr-namespace:Recallr.Models.Models"
             xmlns:m="clr-namespace:Recallr.Models.Configuration"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Recallr.Views.AiChatView">
    <Grid RowDefinitions="45,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBox CornerRadius="12" Grid.Column="0" Height="36" Margin="10,5,5,0" HorizontalAlignment="Stretch"
                     VerticalAlignment="Center"  PlaceholderText="{models:Tr ai_chat_searchbar}" Text=""/>
            <Button Margin="0,5,10,0" Height="35" Classes="primary" Grid.Row="0" Grid.Column="1"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Path Data="M8,2 L8,14 M2,8 L14,8"
                          Stroke="{DynamicResource ButtonPrimaryForeground}"
                          StrokeThickness="2"
                          StrokeLineCap="Round"
                          Width="16" Height="16"
                          Stretch="None"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                    <TextBlock Text="{models:Tr course_add_btn}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource ButtonPrimaryForeground}"/>
                </StackPanel>
            </Button>
        </Grid>
        <Separator Margin="0,10,0,10" Grid.Row="1" />
        <ScrollViewer Margin="10,0,10,0" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            
        </ScrollViewer>
    </Grid>
</UserControl>
