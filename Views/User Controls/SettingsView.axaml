<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Recallr.ViewModels"
             xmlns:models="clr-namespace:Recallr.Models.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Recallr.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Orientation="Vertical" Margin="10,10,10,0" Background="{DynamicResource BackgroundColor}">


            <Grid ColumnDefinitions="*,*" RowDefinitions="*,*">
                <!-- Account Anzeige -->

                <Grid Grid.Row="0" Grid.Column="0" RowDefinitions="Auto,Auto,*,*,*" Margin="0,0,5,0">
                    <TextBlock Grid.Row="0" Text="{models:Tr settings_account_title}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" />
                    <Separator Grid.Row="1" />
                    <Border Grid.Row="2" CornerRadius="12"
                            Margin="0,5,0,0"
                            Padding="16,10"
                            Background="{DynamicResource SurfaceColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="80,*">
                            <TextBlock Grid.Column="0" Text="{models:Tr settings_openAiKey_option}" FontSize="12" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" CornerRadius="2" VerticalAlignment="Center"
                                     HorizontalAlignment="Stretch" PasswordChar="֍" FontSize="8"
                                     VerticalContentAlignment="Center" Text="{Binding DraftOpenaiKey}"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="3" CornerRadius="12"
                            Margin="0,5,0,0"
                            Padding="16,10"
                            Background="{DynamicResource SurfaceColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="80,*">
                            <TextBlock Grid.Column="0" Text="{models:Tr settings_profile_name_option}" FontSize="12" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" CornerRadius="2" VerticalAlignment="Center"
                                     HorizontalAlignment="Stretch" PlaceholderText="Dipsy" Text="{Binding DraftProfileName}"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="4" CornerRadius="12"
                            Margin="0,5,0,0"
                            Padding="16,10"
                            Background="{DynamicResource SurfaceColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="80,*">
                            <TextBlock Grid.Column="0" Text="{models:Tr settings_profile_mail_option}" FontSize="12" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" CornerRadius="2" VerticalAlignment="Center"
                                     HorizontalAlignment="Stretch" PlaceholderText="" Text="{Binding DraftProfileMail}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Darstellungs Anzeige -->

                <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="Auto,Auto,*,*,*" Margin="5,0,0,0">
                    <TextBlock Grid.Row="0" Text="{models:Tr settings_view_title}" FontWeight="Bold" FontSize="18"
                               HorizontalAlignment="Center" />
                    <Separator Grid.Row="1" />
                    <Border Grid.Row="2" CornerRadius="12"
                            Margin="0,5,0,0"
                            Padding="16,10"
                            Background="{DynamicResource SurfaceColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="80,*">
                            <TextBlock Grid.Column="0" Text="{models:Tr settings_theme_option}" FontSize="12" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding DraftTheme}" CornerRadius="12" VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="{models:Tr settings_theme_system}" />
                                <ComboBoxItem Content="{models:Tr settings_theme_dark}" />
                                <ComboBoxItem Content="{models:Tr settings_theme_light}" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Grid.Row="3" CornerRadius="12"
                            Margin="0,5,0,0"
                            Padding="16,10"
                            Background="{DynamicResource SurfaceColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="80,*">
                            <TextBlock Grid.Column="0" Text="{models:Tr settings_language_option}" FontSize="12" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding DraftLanguage}" CornerRadius="12" VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Deutsch" />
                                <ComboBoxItem Content="English" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Grid.Row="4" CornerRadius="12"
                            Margin="0,5,0,0"
                            Padding="16,10"
                            Background="{DynamicResource SurfaceColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="80,*">
                            <TextBlock Grid.Column="0" Text="{models:Tr settings_font_size_option}" FontSize="12" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding DraftFontSize}" CornerRadius="12" VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="14" />
                                <ComboBoxItem Content="16" />
                                <ComboBoxItem Content="18" />
                                <ComboBoxItem Content="20" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- App-Verhalten Anzeige -->

                <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,Auto,*,*,*,*" Margin="0,10,5,0">
                    <TextBlock Grid.Row="0" Text="{models:Tr settings_ai_settings_title}" FontWeight="Bold" FontSize="18"
                               HorizontalAlignment="Center" />
                    <Separator Grid.Row="1" />
                    <Border Grid.Row="2" CornerRadius="12"
                            Margin="0,5,0,0"
                            Padding="16,10"
                            Background="{DynamicResource SurfaceColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="150,*" RowDefinitions="*,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{models:Tr settings_ai_model_option}" FontSize="12" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" CornerRadius="12" VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch" Margin="10,0,0,0" ItemsSource="{Binding Models}" SelectedItem="{Binding DraftAiModel}">
                            </ComboBox>
                            <ProgressBar Grid.Row="1" Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding ModelsLoading}" Margin="10,5,0,0" HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="3" CornerRadius="12"
                            Margin="0,5,0,0"
                            Padding="16,10"
                            Background="{DynamicResource SurfaceColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="150,*">
                            <TextBlock Grid.Column="0" Text="{models:Tr settings_summary_style_option}" FontSize="12"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding DraftSummaryStyle}" CornerRadius="12" VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch" Margin="10,0,0,0">
                                <ComboBoxItem Content="{models:Tr settings_summary_long}" />
                                <ComboBoxItem Content="{models:Tr settings_summary_short}" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Grid.Row="4" CornerRadius="12"
                            Margin="0,5,0,0"
                            Padding="16,10"
                            Background="{DynamicResource SurfaceColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="150,*">
                            <TextBlock Grid.Column="0" Text="{models:Tr settings_difficulty_option}" FontSize="12"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding DraftDifficulty}" CornerRadius="12" VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch" Margin="10,0,0,0">
                                <ComboBoxItem Content="{models:Tr settings_difficulty_difficult}" />
                                <ComboBoxItem Content="{models:Tr settings_difficulty_normal}" />
                                <ComboBoxItem Content="{models:Tr settings_difficulty_easy}" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Grid.Row="5" CornerRadius="12"
                            Margin="0,5,0,0"
                            Padding="16,10"
                            Background="{DynamicResource SurfaceColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="150,*">
                            <TextBlock Grid.Column="0" Text="{models:Tr settings_question_type_option}" FontSize="12" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding DraftQuestionType}" CornerRadius="12" VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch" Margin="10,0,0,0">
                                <ComboBoxItem Content="{models:Tr settings_question_type_multi}" />
                                <ComboBoxItem Content="{models:Tr settings_question_type_open}" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </Grid>
                
                <!-- Credits Anzeige -->
                
                <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,Auto,*,*,*" Margin="5,10,0,0">
                    <TextBlock Grid.Row="0" Text="Recallr" FontWeight="Bold" FontSize="18"
                               HorizontalAlignment="Center" />
                    <Separator Grid.Row="1" />
                    <Border Grid.Row="2" CornerRadius="12"
                            Margin="0,5,0,0"
                            Padding="16,10"
                            Background="{DynamicResource SurfaceColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            HorizontalAlignment="Stretch">
                        <TextBlock Text="{models:Tr settings_recallr_description}" 
                                   TextWrapping="Wrap" FontSize="12" TextAlignment="Justify" LineHeight="16"/>
                    </Border>
                    
                    <!-- Author Anzeige -->
                    
                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,*" Margin="0,5,0,0">
                        <Border Grid.Column="0" CornerRadius="12"
                                Margin="0,5,5,0"
                                Padding="16,10"
                                Background="{DynamicResource SurfaceColor}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Path Data="M12,4 C14.21,4 16,5.79 16,8 C16,10.21 14.21,12 12,12 C9.79,12 8,10.21 8,8 C8,5.79 9.79,4 12,4 Z M12,14 C16.42,14 20,15.79 20,18 L20,20 L4,20 L4,18 C4,15.79 7.58,14 12,14 Z"
                                      Fill="#333333"
                                      Stretch="Uniform"
                                      Width="20"
                                      Height="20"/>
                                <StackPanel Spacing="0">
                                    <TextBlock Text="{models:Tr settings_author_title}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryColor}" />
                                    <TextBlock Text="Dipsy" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryColor}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Framework Anzeige -->
                        
                        <Border Grid.Column="1" CornerRadius="12"
                                Margin="0,5,0,0"
                                Padding="16,10"
                                Background="{DynamicResource SurfaceColor}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Path Data="M12,2 L21,7 L12,12 L3,7 Z M3,12 L12,17 L21,12 M3,17 L12,22 L21,17"
                                      Fill="Transparent"
                                      Stroke="#333333"
                                      StrokeThickness="1.5"
                                      StrokeJoin="Round"
                                      Stretch="Uniform"
                                      Width="16"
                                      Height="16"/>
                                <StackPanel Spacing="0">
                                    <TextBlock Text="{models:Tr settings_framework_title}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryColor}" />
                                    <TextBlock Text="AvaloniaUI • C#" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryColor}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Version Anzeige -->
                        <Border Grid.Column="2" CornerRadius="12"
                                Margin="5,5,0,0"
                                Padding="16,10"
                                Background="{DynamicResource SurfaceColor}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Path Data="M12,2 C17.52,2 22,6.48 22,12 C22,17.52 17.52,22 12,22 C6.48,22 2,17.52 2,12 C2,6.48 6.48,2 12,2 Z M11,10 L13,10 L13,17 L11,17 Z M11,6 L13,6 L13,8.5 L11,8.5 Z"
                                      Fill="#333333"
                                      Stretch="Uniform"
                                      Width="16"
                                      Height="16"/>
                                <StackPanel Spacing="0">
                                    <TextBlock Text="{models:Tr settings_version_title}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryColor}" />
                                    <TextBlock Text="v0.2.0" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryColor}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
            <Separator Height="3" Margin="0,20,0,20" Background="{DynamicResource AccentColor}"/>
            <Grid>
                <Button Classes="edit" HorizontalAlignment="Center" Margin="0,5,0,0" VerticalContentAlignment="Center" Command="{Binding SaveSettingsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M5,3 L16,3 L21,8 L21,19 A2,2 0 0,1 19,21 L5,21 A2,2 0 0,1 3,19 L3,5 A2,2 0 0,1 5,3 Z 
            M7,3 L7,8 L15,8 L15,3 
            M6,13 L18,13 L18,21 L6,21 Z"
                              Fill="Transparent"
                              Stroke="{DynamicResource AccentColor}"
                              StrokeThickness="1.5"
                              StrokeJoin="Round"
                              Stretch="Uniform"
                              Width="16"
                              Height="16"/>
                        <TextBlock Text="{models:Tr settings_save_settings_btn}" Margin="5,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>