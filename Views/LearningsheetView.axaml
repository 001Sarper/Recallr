<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Recallr.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Recallr.Views.LearningsheetView"
             x:DataType="vm:LearningsheetViewModel">
    <Grid RowDefinitions="45,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBox CornerRadius="12" Grid.Column="0" Height="36" Margin="10,5,5,0" HorizontalAlignment="Stretch"
                     VerticalAlignment="Center"  PlaceholderText="Nach Lernzettel suchen..."/>
            <Button Margin="0,5,10,0" Height="35" Classes="primary" Grid.Row="0" Grid.Column="1"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Path Data="M8,2 L8,14 M2,8 L14,8"
                          Stroke="{DynamicResource TextPrimaryColor}"
                          StrokeThickness="2"
                          StrokeLineCap="Round"
                          Width="16" Height="16"
                          Stretch="None"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                    <TextBlock Text="Lernzettel hinzufügen" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryColor}"/>
                </StackPanel>
            </Button>
        </Grid>
        <Separator Margin="0,10,0,10" Grid.Row="1" />
        <ScrollViewer Grid.Row="2" Margin="10,10,10,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel Orientation="Vertical" Spacing="5">
                <Border CornerRadius="12"
                        Padding="16,10"
                        Background="{DynamicResource SurfaceColor}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        HorizontalAlignment="Stretch">
                    <Grid  ColumnDefinitions="*,Auto">
                        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">
                            <TextBlock Grid.Row="0" FontSize="16" Text="Extrempunkte und Wendepunkte" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryColor}"/>
                            <TextBlock Grid.Row="1" FontSize="12" Text="20.06.2026" Foreground="{DynamicResource TextSecondaryColor}" Margin="0,2,0,0" />
                            <TextBlock Grid.Row="2" FontSize="14" Text="In diesem Lernzettel werden Extrempunkte und wichtige Eigenschaften dieser behandelt. Zudem versteht man wie man Hoch- und Tiefpunkte erkennt." TextWrapping="Wrap"/>
                        </Grid>
                        
                        <Grid Grid.Column="1" RowDefinitions="*,*">
                            <Button Grid.Row="0" Classes="edit" Content="Ansehen" Margin="0,0,0,5" Width="100" HorizontalContentAlignment="Center"/>
                            <Button Grid.Row="1" Classes="delete" Content="Löschen" Margin="0,5,0,0" Width="100" HorizontalContentAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
