<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Recallr.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:Recallr.Views"
        xmlns:md="using:Markdown.Avalonia"
        x:DataType="vm:MainViewModel"
        d:DesignWidth="1200" d:DesignHeight="720"
        x:Class="Recallr.Views.MainWindow"
        Title="Recallr"
        Width="1200" Height="720"
        MinWidth="1200" MinHeight="720"
        Background="{DynamicResource BackgroundColor}"
        WindowStartupLocation="CenterScreen">
    

    <Grid ColumnDefinitions="230,*">

        <!-- ============ Sidebar (global, bleibt immer sichtbar) ============ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="20,24,20,20" Orientation="Horizontal">
                    <TextBlock Text="📚" FontSize="22" VerticalAlignment="Center" />
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Text="Recallr"
                                   FontSize="19" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryColor}" />
                        <TextBlock Text="Dein smarter Lernbegleiter"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryColor}" />
                    </StackPanel>
                </StackPanel>

                <!-- Globale Navigation -->
                <StackPanel Grid.Row="1" Margin="12,0" Spacing="4">
                    <ListBox SelectedIndex="{Binding SelectedNavIndex}" Background="Transparent" x:Name="NavList">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="Margin" Value="0,2" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                            </Style>
                        </ListBox.Styles>

                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🎓" FontSize="16" />
                                <TextBlock Text="Meine Fächer" Foreground="{DynamicResource TextPrimaryColor}" />
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="⚙️" FontSize="16" />
                                <TextBlock Text="Einstellungen" Foreground="{DynamicResource TextPrimaryColor}" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </StackPanel>

                <!-- Streak / User -->
                <Border Grid.Row="2" Margin="12,0,12,16" Padding="12" CornerRadius="10"
                        Background="{DynamicResource BackgroundColor}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="👤" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Spacing="0">
                            <TextBlock Text="{Binding Settings.ProfileName}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryColor}" />
                            <TextBlock Text="{Binding Settings.ProfileMail}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryColor}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ Rechte Seite: Breadcrumb + die 3 Panels ============ -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <!-- Breadcrumb-Leiste -->
            <Border Grid.Row="0"
                    Padding="24,14"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*">
                    <Button Grid.Column="0" Content="←"
                            Command="{Binding GoBackCommand}"
                            Background="Transparent"
                            Foreground="{DynamicResource TextPrimaryColor}"
                            BorderThickness="0" FontSize="16" Padding="6" Margin="0,0,12,0" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="{Binding AppState.CurrentOption}" Foreground="{DynamicResource TextSecondaryColor}" FontSize="13" />
                        <TextBlock Text="›" IsVisible="{Binding AppState.OptionArrow1}" Foreground="{DynamicResource TextSecondaryColor}" FontSize="13" />
                        <TextBlock Text="{Binding AppState.CurrentCourse}" Foreground="{DynamicResource TextSecondaryColor}" FontSize="13" />
                        <TextBlock Text="›" IsVisible="{Binding AppState.OptionArrow2}" Foreground="{DynamicResource TextSecondaryColor}" FontSize="13" />
                        <TextBlock Text="{Binding AppState.CurrentLearningsheet}"
                                   Foreground="{DynamicResource TextPrimaryColor}" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Container für alle 3 Panels (übereinander, per IsVisible umschaltbar) -->
            <Grid Grid.Row="1">
                <ContentControl Content="{Binding AppState.CurrentPageViewModel}"/>
                
                <!-- Layer 2: Overlay, nur sichtbar wenn ein Dialog offen ist -->
                <Grid IsVisible="{Binding AppState.IsOverlayVisible}" >
                    <!-- Abdunkelung -->
                    <Border Background="#AA000000" />

                    <!-- Der eigentliche Dialoginhalt -->
                    <Border Background="{DynamicResource BackgroundColor}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            BorderBrush="{DynamicResource AccentColor}"
                            BorderThickness="2"
                            CornerRadius="12">
                        <ContentControl Content="{Binding AppState.CurrentDialog}"
                                        Width="400"
                                        Height="150"/>
                    </Border>
                </Grid>
            </Grid>
            
            <!-- <TextBlock Grid.Row="0" Text="Datei hochladen und zusammenfassen" Margin="10"/>
                <Grid Grid.Row="1" RowDefinitions="50,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                        <Button Content="Datei hochladen" Command="{Binding PickFileCommand}"></Button>
                        <Button Content="Datei zusammenfassen" Command="{Binding CreateLearningsheetCommand}"></Button>
                        <Button Content="Dummy Text" Command="{Binding LoadDummyTextFileCommand}"></Button>
                        <TextBlock Text="{Binding Paths.Count, StringFormat='{}{0} Datei(en) ausgewählt'}"/>
                    </StackPanel>
                    <md:MarkdownScrollViewer Margin="10" Markdown="{Binding Lernzettel}" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </Grid>
            -->
        </Grid>
    </Grid>
</Window>
