<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Recallr.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900" Width="1440" Height="900" MinWidth="1024" MinHeight="600" WindowState="Maximized"
        x:Class="Recallr.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Recallr">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="200" MaxWidth="500"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" RowDefinitions="*,50">
            <StackPanel Grid.Row="0" Orientation="Vertical" Background="Aqua">
                <Button HorizontalAlignment="Center" Margin="10" Width="280" >
                    <StackPanel Orientation="Horizontal" Spacing="8" 
                                VerticalAlignment="Center">
                        <!-- Plus Icon als Path -->
                        <!-- Minimalistisches Buch - GEOMTRISCHE FORMEN -->
                        <Image Source="avares://Recallr/Assets/icons-book.png" Width="25" Height="25"/>
                        
                        <!-- Text daneben -->
                        <TextBlock Text="Mathe" 
                                   Foreground="White"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <Panel Grid.Row="1" Background="Aqua">
                <Button HorizontalAlignment="Right" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" 
                                VerticalAlignment="Center">
                        <!-- Plus Icon als Path -->
                        <Path Fill="White" 
                              Width="16" Height="16"
                              Stretch="Uniform"
                              Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
        
                        <!-- Text daneben -->
                        <TextBlock Text="Neues Fach erstellen" 
                                   Foreground="White"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Panel>
        </Grid>
        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#CCCCCC"
                      ShowsPreview="True"/>
        
    </Grid>

    

</Window>
